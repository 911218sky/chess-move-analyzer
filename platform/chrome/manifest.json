{
  "manifest_version": 3,
  "name": "Chess Move Analyzer",
  "version": "1.0",
  "description": "Analyze and solve your Chess.com games with real-time suggestions.",
  "permissions": ["activeTab", "storage", "offscreen", "scripting"],
  "host_permissions": ["*://www.chess.com/*", "https://api.github.com/*", "<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "background": {
    "service_worker": "js/background/background.chrome.js"
  },
  "action": {
    "default_popup": "pub/popup.html",
    "default_icon": {
      "16": "res/ext_icon_144.png",
      "32": "res/ext_icon_144.png",
      "48": "res/ext_icon_144.png",
      "128": "res/ext_icon_144.png"
    }
  },
  "icons": {
    "16": "res/ext_icon_144.png",
    "32": "res/ext_icon_144.png",
    "48": "res/ext_icon_144.png",
    "128": "res/ext_icon_144.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.chess.com/*"],
      "js": [
        "js/core/extension-api.js",
        "js/shared/errors.js",
        "js/shared/display.js",
        "js/content/content.js"
      ]
    }
  ]
}
